# KrishiLink Backend Environment Variables

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_USERNAME=your_mongodb_username
DB_PASSWORD=your_mongodb_password

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=4000
NODE_ENV=development

# ============================================
# FRONTEND & CORS CONFIGURATION
# ============================================
# Comma-separated list of allowed frontend origins
# Examples:
#   Development: http://localhost:5173,http://localhost:3000
#   Production: https://krishilink.vercel.app,https://www.krishilink.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend URL for redirects (payment callbacks, etc.)
FRONTEND_URL=http://localhost:5173

# Backend URL for SSLCommerz callbacks
BACKEND_URL=http://localhost:4000

# ============================================
# FIREBASE ADMIN CONFIGURATION
# ============================================
# Download service account key from Firebase Console
# Project Settings > Service Accounts > Generate New Private Key
# Set the path to the JSON file or use environment variables
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour Private Key Here\n-----END PRIVATE KEY-----"

# Or use the JSON file path (alternative method)
# FIREBASE_SERVICE_ACCOUNT_PATH=./path/to/serviceAccountKey.json

# ============================================
# SSLCOMMERZ PAYMENT CONFIGURATION
# ============================================
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
# Set to "true" for production payments, "false" for sandbox
SSLCOMMERZ_IS_LIVE=false

# ============================================
# SECURITY CONFIGURATION
# ============================================
# Rate Limiting (requests per window)
# Current defaults in code: 100 requests per 15 minutes
# Uncomment to customize:
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# LOGGING CONFIGURATION (Pino Structured Logging)
# ============================================

# Log level: trace, debug, info, warn, error, fatal
# Development: debug | Production: info
LOG_LEVEL=debug

# Service name for log identification
SERVICE_NAME=krishilink-api

# ============================================
# OPTIONAL: ADVANCED CONFIGURATION
# ============================================
# Request body size limit (default: 10mb)
# BODY_SIZE_LIMIT=10mb

# CORS credentials (default: true)
# CORS_CREDENTIALS=true

# Enable/disable specific HTTP methods
# CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
